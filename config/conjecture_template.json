{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physics Conjecture Schema",
  "type": "object",
  "required": ["name", "axioms", "claims", "targets"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Short name for the conjecture"
    },
    "description": {
      "type": "string",
      "description": "1-3 paragraph overview of the conjecture"
    },
    "framework": {
      "type": "string",
      "description": "Mathematical framework (e.g., SL(6,C) gauge theory, AdS/CFT)",
      "default": "General"
    },
    "domain": {
      "type": "string",
      "enum": ["high-energy", "cosmology", "condensed-matter", "quantum-gravity", "mathematical-physics", "other"],
      "default": "mathematical-physics"
    },
    "axioms": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^A\\d+$"},
          "description": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["honest-axiom", "proven-theorem", "geometric-conjecture", "definition"],
            "default": "honest-axiom"
          },
          "literature": {"type": "string"},
          "lean_formalization": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^C\\d+$"},
          "description": {"type": "string"},
          "expected_value": {},
          "tolerance": {"type": "number", "default": 0.05}
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^T\\d+$"},
          "description": {"type": "string"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Key physical parameters with known values or ranges"
    },
    "brain_concepts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Key concepts to query from neural memory brain"
    }
  }
}
